// Prisma Schema for FengXue Chinese Learning Platform
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------
// NOTE: profiles.id references auth.users(id) in Supabase.
// Prisma cannot model cross-schema FK directly, so we
// define id as String and handle the FK via raw SQL in
// the custom migration (prisma/migrations/0001_init/).
// -------------------------------------------------------

model Profile {
  id              String          @id @db.Uuid
  fullName        String          @default("") @map("full_name")
  phone           String          @unique @default("")
  avatarUrl       String?         @map("avatar_url")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at")
  vocabularySets     VocabularySet[]
  exerciseRecords    ExerciseRecord[]
  dictionaryProgress DictionaryProgress[]
  practiceSessions   PracticeSession[]
  tocflAttempts      TocflAttempt[]
  topicVocabularyProgress TopicVocabularyProgress[]
  fullDictionaryProgress FullDictionaryProgress[]

  @@map("profiles")
}

model VocabularySet {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  date         DateTime     @db.Date
  createdAt    DateTime     @default(now()) @map("created_at")
  user         Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularies Vocabulary[]

  @@unique([userId, date]) 
  @@map("vocabulary_sets")
}

model Vocabulary {
  id         String        @id @default(uuid()) @db.Uuid
  setId      String        @map("set_id") @db.Uuid
  hanzi      String
  pinyin     String
  vietnamese String
  // Browsing category on /vocabulary: 'study' (Từ vựng tự học) or 'practice'
  // (Từ vựng khác). Lives on the word, not the set, so a single day's set can mix both.
  source     String        @default("study")
  orderIndex Int           @default(0) @map("order_index")
  // Backfilled at Excel-import time when the word matches an entry in dictionary_words,
  // so Flashcard can show the same accurate example used on /dictionary and
  // /review-dictionary instead of the generic /api/examples fallback.
  exampleHanzi      String? @map("example_hanzi")
  examplePinyin     String? @map("example_pinyin")
  exampleVietnamese String? @map("example_vietnamese")
  // Where the example sentence came from: 'manual' (typed on /vocabulary), 'ai'
  // (OpenRouter-generated), 'dictionary' (backfilled from dictionary_words at import
  // time), or null (no example yet). Lets the AI generate-example endpoint skip words
  // that already have a manual or dictionary example instead of overwriting them.
  exampleSource     String? @map("example_source")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at")
  set        VocabularySet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@map("vocabularies")
}

model ExerciseRecord {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  date         DateTime  @db.Date
  exerciseType String    @map("exercise_type")
  isCompleted  Boolean   @default(false) @map("is_completed")
  score        Int?
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, exerciseType])
  @@map("exercise_records")
}

// Shared, read-only reference dictionary imported from vocabulary PDFs (e.g. TOCFL Band A/B/C).
// Rows are written only by scripts/import-dictionary-pdf.js, never by end users.
model DictionaryWord {
  id         String   @id @default(uuid()) @db.Uuid
  band       String
  level      String
  hanzi      String
  pinyin     String
  vietnamese String
  pos        String?
  orderIndex Int      @default(0) @map("order_index")
  exampleHanzi      String? @map("example_hanzi")
  examplePinyin     String? @map("example_pinyin")
  exampleVietnamese String? @map("example_vietnamese")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([level, hanzi, pinyin, vietnamese])
  @@map("dictionary_words")
}

// Tracks, per user + level + mode, which dictionary words have already been studied
// so that "Ôn tập theo từ điển" stages never repeat a word until the whole level has
// been covered. `mode` ('flashcard' | 'fill_in') keeps Flashcard and Điền Từ progress
// independent of each other for the same level.
model DictionaryProgress {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  level        String
  mode         String   @default("flashcard")
  wordOrder    String[] @map("word_order") @db.Uuid
  currentIndex Int      @default(0) @map("current_index")
  updatedAt    DateTime @default(now()) @map("updated_at")
  user         Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, level, mode])
  @@map("dictionary_progress")
}

// Attempt history for the auto-generated TOCFL practice-exam quizzes (MCQ/cloze/reorder).
model PracticeSession {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  level          String
  totalQuestions Int      @map("total_questions")
  correctCount   Int      @map("correct_count")
  createdAt      DateTime @default(now()) @map("created_at")
  user           Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("practice_sessions")
}

// Shared, read-only reading/listening comprehension content for the practice-exam
// feature (short passages and two-speaker dialogues), modeled on TOCFL Band A's
// 短文閱讀 (reading passage) and 問答/言談理解 (listening dialogue) question types.
// Rows are written only by scripts/build-comprehension-seed.js, never by end users.
model ComprehensionPassage {
  id                String                  @id @default(uuid()) @db.Uuid
  level             String
  mode              String                  // 'reading' | 'listening'
  passageHanzi      String                  @map("passage_hanzi")
  passagePinyin     String                  @map("passage_pinyin")
  passageVietnamese String                  @map("passage_vietnamese")
  createdAt         DateTime                @default(now()) @map("created_at")
  questions         ComprehensionQuestion[]

  @@map("comprehension_passages")
}

model ComprehensionQuestion {
  id            String               @id @default(uuid()) @db.Uuid
  passageId     String               @map("passage_id") @db.Uuid
  orderIndex    Int                  @default(0) @map("order_index")
  questionHanzi String               @map("question_hanzi")
  options       String[]
  correctIndex  Int                  @map("correct_index")
  createdAt     DateTime             @default(now()) @map("created_at")
  passage       ComprehensionPassage @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@map("comprehension_questions")
}

// Real TOCFL Band A official mock-exam papers (5 papers, listening + reading,
// sourced from the official past-paper PDFs/audio). Rows written only by
// scripts/build-tocfl-seed.js, never by end users.
model TocflPaper {
  id                    String   @id @default(uuid()) @db.Uuid
  band                  String   @default("A")
  paperNumber           Int      @map("paper_number")
  title                 String
  listeningTimeMinutes  Int      @default(60) @map("listening_time_minutes")
  readingTimeMinutes    Int      @default(60) @map("reading_time_minutes")
  listeningIntroAudio   Json     @default("{}") @map("listening_intro_audio")
  createdAt             DateTime @default(now()) @map("created_at")
  questions             TocflQuestion[]
  attempts              TocflAttempt[]

  @@unique([band, paperNumber])
  @@map("tocfl_papers")
}

model TocflQuestion {
  id             String     @id @default(uuid()) @db.Uuid
  paperId        String     @map("paper_id") @db.Uuid
  section        String     // 'listening' | 'reading'
  partNumber     Int        @map("part_number")
  questionNumber Int        @map("question_number")
  questionType   String     @map("question_type")
  groupKey       String?    @map("group_key")
  orderIndex     Int        @map("order_index")
  promptHanzi    String?    @map("prompt_hanzi")
  promptImagePath String?   @map("prompt_image_path")
  passageHanzi   String?    @map("passage_hanzi")
  audioPath      String?    @map("audio_path")
  options        Json
  correctIndex   Int        @map("correct_index")
  createdAt      DateTime   @default(now()) @map("created_at")
  paper          TocflPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, section, questionNumber])
  @@map("tocfl_questions")
}

// Per-user mock-exam attempt history, powering the score-progress grid on /thi-thu.
model TocflAttempt {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  paperId           String     @map("paper_id") @db.Uuid
  status            String     @default("in_progress")
  listeningCorrect  Int?       @map("listening_correct")
  listeningTotal    Int?       @map("listening_total")
  readingCorrect    Int?       @map("reading_correct")
  readingTotal      Int?       @map("reading_total")
  totalCorrect      Int?       @map("total_correct")
  totalQuestions    Int?       @map("total_questions")
  scorePercent      Decimal?   @map("score_percent") @db.Decimal(5, 2)
  bandResult        String?    @map("band_result")
  answers           Json       @default("{}")
  startedAt         DateTime   @default(now()) @map("started_at")
  completedAt       DateTime?  @map("completed_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  user              Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper             TocflPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@map("tocfl_attempts")
}

// Backs the "Học Từ Vựng Theo Chủ Đề" page. Deliberately separate from DictionaryWord/
// DictionaryProgress — never touched by the existing Ôn Tập Từ Điển flow, so nothing here
// can affect a student's saved flashcard/fill-in progress. A1/A2/B1 rows are scraped from
// monchinese.me's topic collections (their #1/#2/#3 sub-groups merged into one row set per
// topic); B2 rows are this app's own dictionary_words auto-classified into the same topic
// taxonomy by keyword, since monchinese has no B2 tier to source from.
model TopicVocabulary {
  id                String   @id @default(uuid()) @db.Uuid
  level             String
  topicKey          String   @map("topic_key")
  topicLabel        String   @map("topic_label")
  topicIcon         String   @map("topic_icon")
  hanzi             String
  hanziVariant      String?  @map("hanzi_variant")
  pinyin            String
  vietnamese        String
  pos               String?
  exampleHanzi      String?  @map("example_hanzi")
  examplePinyin     String?  @map("example_pinyin")
  exampleVietnamese String?  @map("example_vietnamese")
  source            String   @default("monchinese")
  orderIndex        Int      @default(0) @map("order_index")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([level, topicKey, hanzi, pinyin])
  @@map("topic_vocabulary")
}

// Per-user progress for the topic-vocabulary page, mirroring DictionaryProgress's shape
// but keyed by (level, topicKey) and with a third mode. See migration 0014's comment for
// the 'flashcard' -> 'matching' -> 'fill_in' gating chain.
model TopicVocabularyProgress {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  level        String
  topicKey     String   @map("topic_key")
  mode         String
  wordOrder    String[] @default([]) @map("word_order") @db.Uuid
  currentIndex Int      @default(0) @map("current_index")
  updatedAt    DateTime @default(now()) @map("updated_at")
  user         Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, level, topicKey, mode])
  @@map("topic_vocabulary_progress")
}

// Per-user progress for the "Tổng Hợp Từ Điển" page (/full-dictionary), mirroring
// TopicVocabularyProgress's 3-mode gating chain but keyed by level only — this page
// studies DictionaryWord directly (grouped by level), not TopicVocabulary. See
// migration 0015's comment for why this is a separate table from DictionaryProgress.
model FullDictionaryProgress {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  level        String
  mode         String
  wordOrder    String[] @default([]) @map("word_order") @db.Uuid
  currentIndex Int      @default(0) @map("current_index")
  updatedAt    DateTime @default(now()) @map("updated_at")
  user         Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, level, mode])
  @@map("full_dictionary_progress")
}

// Backs the "Tổng Hợp Từ Điển" page's dictionary browsing table + study pool. Sourced
// 100% from monchinese.me/dictionary?level=X per explicit user request — deliberately
// separate from DictionaryWord for the same reason TopicVocabulary is (see its comment):
// this page's word list/pinyin/examples must track monchinese exactly, which can
// legitimately disagree with this app's own TOCFL-band dictionary_words content.
model FullDictionaryWord {
  id                String   @id @default(uuid()) @db.Uuid
  level             String
  hanzi             String
  hanziVariant      String?  @map("hanzi_variant")
  pinyin            String
  vietnamese        String
  pos               String?
  exampleHanzi      String?  @map("example_hanzi")
  examplePinyin     String?  @map("example_pinyin")
  exampleVietnamese String?  @map("example_vietnamese")
  source            String   @default("monchinese")
  orderIndex        Int      @default(0) @map("order_index")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([level, hanzi, pinyin])
  @@map("full_dictionary_words")
}
